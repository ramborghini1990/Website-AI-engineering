    "State-of-the-art models",
    "An all'avanguardia platform",
    "A magic solution",
    "TODO write this",
    "Lorem ipsum dolor",
    "Hello {{name}}",
  ])("flags: %s (negative)", (text) => {
    expect(claimProblems(text).length, text).toBeGreaterThan(0);
  });

  it.each([
