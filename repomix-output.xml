<file path="src/lib/theme.ts">
/**
 * Theme choice (docs/DESIGN.md §8): "system" follows the OS, "dark" and "light"
 * force a theme with a class on <html>. The choice is stored on the visitor's
 * device in ONE localStorage key, only when they pick dark or light (choosing
 * "system" removes it). It is a functional preference, set by the visitor's own
 * action, and must appear in the storage table of the cookie policy (P4.2).
 */
export const THEME_STORAGE_KEY = "theme";

export type ThemeChoice = "system" | "dark" | "light";

const CHANGE_EVENT = "themechange";

/** The stored choice, or "system". Never throws (storage can be blocked). */
export function readStoredTheme(): ThemeChoice {
  try {
    const value = window.localStorage.getItem(THEME_STORAGE_KEY);
    return value === "dark" || value === "light" ? value : "system";
  } catch {
    return "system";
  }
}

function setRootClass(choice: ThemeChoice) {
  const root = document.documentElement;
  root.classList.remove("dark", "light");
  if (choice !== "system") root.classList.add(choice);
}

/**
 * Put a STORED choice back on <html>. Needed after a client-side navigation
 * that remounts the root layout (switching language does): the new <html>
 * element never ran the pre-paint script.
 *
 * With nothing stored it does nothing, on purpose: a fresh <html> has no theme
 * class, and stripping classes here would clobber one set by anything else
 * (devtools, an extension, a test) the moment React hydrates. Removing a class
 * is the job of `applyTheme("system")` and of the cross-tab `storage` handler.
 */
export function syncThemeFromStorage() {
  const stored = readStoredTheme();
  if (stored !== "system") setRootClass(stored);
}

/** Apply a choice now and remember it (or forget it for "system"). */
export function applyTheme(choice: ThemeChoice) {
  setRootClass(choice);
  try {
    if (choice === "system") window.localStorage.removeItem(THEME_STORAGE_KEY);
    else window.localStorage.setItem(THEME_STORAGE_KEY, choice);
  } catch {
    // Storage blocked: the choice still applies to this page view.
  }
  window.dispatchEvent(new Event(CHANGE_EVENT));
}

/**
 * Subscribe to changes made in this tab (our own event) and in other tabs
 * (`storage`), keeping the class on <html> in step with the stored choice.
 */
export function subscribeTheme(onChange: () => void): () => void {
  const onStorage = (event: StorageEvent) => {
    if (event.key === THEME_STORAGE_KEY || event.key === null) {
      setRootClass(readStoredTheme());
      onChange();
    }
  };
  window.addEventListener("storage", onStorage);
  window.addEventListener(CHANGE_EVENT, onChange);
  return () => {
    window.removeEventListener("storage", onStorage);
    window.removeEventListener(CHANGE_EVENT, onChange);
  };
}

/**
 * Inline script that runs before first paint so a stored choice does not flash
 * the wrong theme. A constant: it contains no user input. It needs the CSP
 * nonce (the layout passes it) and must stay tiny and free of `<` and `&`.
 */
export const themeInitScript = `(function(){try{var t=localStorage.getItem(${JSON.stringify(THEME_STORAGE_KEY)});if(t==="dark"||t==="light"){document.documentElement.classList.add(t)}}catch(e){}})()`;
</file>

<file path="src/test-utils/match-media.ts">
import { vi } from "vitest";

type Listener = (event: { matches: boolean; media: string }) => void;

/**
 * jsdom has no `matchMedia`. This fake answers the reduced-motion queries from
 * one flag, answers the pointer query from another, and lets a test flip them
 * while the code under test is subscribed.
 *
 *   const media = mockReducedMotion(false);
 *   media.set(true); // fires "change" on every subscribed query
 *   mockReducedMotion(false, { finePointer: true }); // a desktop mouse
 */
export function mockReducedMotion(
  initial: boolean,
  options: { finePointer?: boolean } = {},
) {
  let reduced = initial;
  const finePointer = options.finePointer ?? false;
  const subscribers = new Map<string, Set<Listener>>();

  const matchesFor = (query: string) => {
    if (query.includes("prefers-reduced-motion: reduce")) return reduced;
    if (query.includes("prefers-reduced-motion: no-preference"))
      return !reduced;
    if (query.includes("hover: hover") && query.includes("pointer: fine"))
      return finePointer;
    return false;
  };

  const matchMedia = vi.fn((query: string) => {
    const listeners = subscribers.get(query) ?? new Set<Listener>();
    subscribers.set(query, listeners);
    return {
      get matches() {
        return matchesFor(query);
      },
      media: query,
      onchange: null,
      addEventListener: (_type: string, listener: Listener) => {
        listeners.add(listener);
      },
      removeEventListener: (_type: string, listener: Listener) => {
        listeners.delete(listener);
      },
      // legacy API, used by GSAP's matchMedia
      addListener: (listener: Listener) => {
        listeners.add(listener);
      },
      removeListener: (listener: Listener) => {
        listeners.delete(listener);
      },
      dispatchEvent: () => true,
    };
  });

  vi.stubGlobal("matchMedia", matchMedia);
  window.matchMedia = matchMedia as unknown as typeof window.matchMedia;

  return {
    set(next: boolean) {
      reduced = next;
      for (const [query, listeners] of subscribers) {
        for (const listener of [...listeners]) {
          listener({ matches: matchesFor(query), media: query });
        }
      }
    },
    /** Number of live subscriptions, to prove cleanup. */
    listenerCount() {
      let count = 0;
      for (const listeners of subscribers.values()) count += listeners.size;
      return count;
    },
  };
}
</file>

<file path="src/no-raw-colors.test.ts">
// @vitest-environment node
import { readdirSync, readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { describe, expect, it } from "vitest";

/**
 * CLAUDE.md §7 / ROADMAP P1.2: no raw colour values in components. Colours
 * come from the semantic tokens in globals.css (bg-bg, text-text, ...).
 *
 * Because globals.css removes Tailwind's default palette, classes such as
 * `bg-zinc-50` or `text-white` no longer generate any CSS. They would fail
 * silently, so they are rejected here too.
 */

const srcRoot = fileURLToPath(new URL("./", import.meta.url));

const RAW_COLOR = [
  // #rgb, #rgba, #rrggbb, #rrggbbaa (not part of a word, an entity like &#39; or an anchor id)
  /(?<![\w&])#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4})(?![\w-])/g,
  // colour functions
  /\b(?:rgba?|hsla?|hwb|oklab|oklch)\(/g,
  // Tailwind default-palette classes (palette is cleared, so they generate nothing)
  /\b(?:bg|text|border|ring|fill|stroke|from|via|to|outline|decoration|divide|accent|caret|shadow)-(?:slate|gray|zinc|neutral|stone|red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose)-\d{2,3}\b/g,
  /\b(?:bg|text|border|ring|fill|stroke|outline|decoration|divide)-(?:white|black)\b/g,
];

/** Every raw-colour match in `source`. */
function findRawColors(source: string): string[] {
  return RAW_COLOR.flatMap((pattern) => source.match(pattern) ?? []);
}

/** Component and app source files; globals.css (the token source) and tests are exempt. */
function sourceFiles(): string[] {
  return readdirSync(srcRoot, { recursive: true, encoding: "utf8" })
    .map((p) => p.replace(/\\/g, "/"))
    .filter((p) => /\.(?:tsx?|css|mdx?)$/.test(p))
    .filter((p) => !/\.test\.(?:tsx?)$/.test(p))
    .filter((p) => p !== "app/globals.css");
}

describe("no raw colours in components", () => {
  it("scans a non-empty set of source files", () => {
    const files = sourceFiles();
    expect(files).toContain("app/[locale]/page.tsx");
    expect(files).toContain("app/[locale]/layout.tsx");
    expect(files).not.toContain("app/globals.css");
  });

  it("finds no hex, rgb()/hsl()/oklch() or default-palette classes in src", () => {
    const violations = sourceFiles().flatMap((file) =>
      findRawColors(readFileSync(srcRoot + file, "utf8")).map(
        (match) => `${file}: ${match}`,
      ),
    );
    expect(violations).toEqual([]);
  });
});

describe("raw colour scanner (negative cases)", () => {
  it.each([
    ['className="bg-[#ff0000]"', "#ff0000"],
    ['className="text-[#fff]"', "#fff"],
    ['className="text-[#ffffff80]"', "#ffffff80"],
    ['style={{ color: "rgb(1, 2, 3)" }}', "rgb("],
    ['const c = "hsl(200 50% 50%)"', "hsl("],
    ['const c = "oklch(0.7 0.1 200)"', "oklch("],
    ['className="bg-zinc-50"', "bg-zinc-50"],
    ['className="dark:text-red-500"', "text-red-500"],
    ['className="text-white"', "text-white"],
    ['className="border-black"', "border-black"],
  ])("flags %s", (source, expected) => {
    expect(findRawColors(source)).toContain(expected);
  });

  it("does not flag semantic tokens, entities, anchors or ordinary words", () => {
    const clean = [
      'className="bg-bg text-text border-border-strong text-accent/40"',
      'className="bg-surface-2 shadow-popover rounded-sm"',
      "&#39;quoted&#39; and &#x27;",
      '<a href="#main-content">skip</a>',
      '<a href="#faq">faq</a>',
