import { useEffect, useState } from "react";

/** Becomes true once the browser is idle, so loading motion code never competes with first render. */
export function useAfterIdle(): boolean {
  const [idle, setIdle] = useState(false);
  useEffect(() => {
    if (typeof requestIdleCallback === "function") {
      const handle = requestIdleCallback(
        () => {
          setIdle(true);
        },
        { timeout: 2000 },
      );
      return () => {
        cancelIdleCallback(handle);
      };
    }
    const handle = window.setTimeout(() => {
      setIdle(true);
    }, 200);
    return () => {
      window.clearTimeout(handle);
    };
  }, []);
  return idle;
}
</file>

<file path="src/lib/motion/use-media-query.ts">
import { useSyncExternalStore } from "react";

/**
 * True while `query` matches; follows changes live. `false` on the server and
 * during hydration, so server HTML and the first client render agree.
 */
export function useMediaQuery(query: string): boolean {
  return useSyncExternalStore(
    (onChange) => {
      const list = window.matchMedia(query);
      list.addEventListener("change", onChange);
      return () => {
        list.removeEventListener("change", onChange);
      };
    },
    () => window.matchMedia(query).matches,
    () => false,
  );
}
</file>

