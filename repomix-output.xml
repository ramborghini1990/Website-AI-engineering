<file path=".github/workflows/ci.yml">
name: CI

on:
  pull_request:
  push:
    branches: [main]

# Least privilege: jobs only read the repository.
permissions:
  contents: read

# A newer push to the same ref makes the older run obsolete.
concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  verify:
    name: verify
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      # pnpm comes from the `packageManager` field via Corepack. It must be
      # enabled before setup-node so that `cache: pnpm` can find it.
      - name: Enable Corepack
        run: corepack enable

      - name: Set up Node.js
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version-file: .nvmrc
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      # typecheck + lint + unit tests + production build
      - name: Verify
        run: pnpm verify
        env:
          # This job has no secrets, so `next build` must not demand them.
          # The flag is honoured only during the build (src/lib/env-schema.ts):
          # it is ignored at runtime. The unit tests still validate the env
          # contract (.env.example parses). docs/SECURITY.md §2.
          SKIP_ENV_VALIDATION: "1"

      - name: Dead code (knip)
        run: pnpm knip

      - name: Formatting (prettier)
        run: pnpm format:check

  e2e:
    name: e2e
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Enable Corepack
        run: corepack enable

      - name: Set up Node.js
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version-file: .nvmrc
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      # Browser binaries are keyed on the lockfile, which pins the Playwright version.
      - name: Cache Playwright browsers
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ~/.cache/ms-playwright
          key: playwright-${{ runner.os }}-${{ hashFiles('pnpm-lock.yaml') }}

      # System dependencies are installed on every run; the browser download is skipped on a cache hit.
      - name: Install Playwright Chromium
        run: pnpm exec playwright install --with-deps chromium

      # Deliberately WITHOUT SKIP_ENV_VALIDATION: this job builds and starts the
      # app with an empty environment, which proves a fresh clone validates.
      # When a variable becomes required in production (docs/SECURITY.md §2),
      # give this job synthetic test values for it here.
      - name: End-to-end and accessibility tests
        run: pnpm test:e2e

      - name: Upload Playwright report
        if: failure()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: playwright-report
          path: |
            playwright-report/
            test-results/
          retention-days: 7
          if-no-files-found: ignore
</file>

