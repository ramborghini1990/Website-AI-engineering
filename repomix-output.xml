import { act, render } from "@testing-library/react";
import { useRef } from "react";
import { afterEach, describe, expect, it, vi } from "vitest";

import { mockReducedMotion } from "@/test-utils/match-media";
import { gsap } from "@/lib/motion/gsap";
import { useMotion, type MotionContext } from "@/lib/motion/use-motion";

afterEach(() => {
  vi.unstubAllGlobals();
  vi.useRealTimers();
});

/**
 * GSAP's matchMedia ignores a change that arrives within 2ms of the previous
 * one (it reads Date.now()). People change the OS setting seconds apart, so
 * move the clock forward between flips, like a real session.
 */
let clock = Date.now();
function flip(media: ReturnType<typeof mockReducedMotion>, reduced: boolean) {
  // GSAP keeps the time of the last change in a module variable that outlives
  // a test, so the fake clock must only ever move forward across the whole file.
  clock += 1000;
  vi.setSystemTime(clock);
  act(() => {
    media.set(reduced);
  });
}

function Probe({ onBuild }: { onBuild: (context: MotionContext) => void }) {
  const scope = useRef<HTMLDivElement>(null);
  useMotion(
    (context) => {
      onBuild(context);
      // A long tween: if it were not reverted it would still be alive later.
      gsap.to(".box", { x: 10, duration: 60 });
    },
    { scope },
  );
  return (
    <div ref={scope}>
      <div className="box" data-testid="box" />
    </div>
  );
}

describe("useMotion", () => {
  it("builds with reduced=false when the visitor has no preference", () => {
    mockReducedMotion(false);
    const onBuild = vi.fn();

    render(<Probe onBuild={onBuild} />);

    expect(onBuild).toHaveBeenCalledTimes(1);
    expect(onBuild).toHaveBeenCalledWith(
      expect.objectContaining({ reduced: false }),
    );
  });

  it("builds with reduced=true when the visitor asks for reduced motion", () => {
    mockReducedMotion(true);
    const onBuild = vi.fn();

    render(<Probe onBuild={onBuild} />);

    expect(onBuild).toHaveBeenCalledTimes(1);
    expect(onBuild).toHaveBeenCalledWith(
      expect.objectContaining({ reduced: true }),
    );
  });

  it("rebuilds with the new value each time the preference changes, without stacking tweens", () => {
    vi.useFakeTimers({ toFake: ["Date"] });
    const media = mockReducedMotion(false);
    const onBuild = vi.fn();
    const { getByTestId } = render(<Probe onBuild={onBuild} />);
    const box = getByTestId("box");
    expect(gsap.getTweensOf(box)).toHaveLength(1);

    flip(media, true);
    expect(onBuild).toHaveBeenLastCalledWith(
      expect.objectContaining({ reduced: true }),
    );
    expect(gsap.getTweensOf(box)).toHaveLength(1); // the old one was reverted

    flip(media, false);
    expect(onBuild).toHaveBeenLastCalledWith(
      expect.objectContaining({ reduced: false }),
    );
    expect(gsap.getTweensOf(box)).toHaveLength(1);

    flip(media, true);
    expect(onBuild).toHaveBeenLastCalledWith(
      expect.objectContaining({ reduced: true }),
    );
    expect(gsap.getTweensOf(box)).toHaveLength(1);
    expect(onBuild).toHaveBeenCalledTimes(4); // mount + three flips, no extras
  });

  it("reverts everything on unmount (nothing left running)", () => {
    mockReducedMotion(false);
    const { getByTestId, unmount } = render(<Probe onBuild={vi.fn()} />);
    const box = getByTestId("box");
    expect(gsap.getTweensOf(box)).toHaveLength(1);

    unmount();

    expect(gsap.getTweensOf(box)).toHaveLength(0);
  });

  it("runs the cleanup function that build returns on unmount", () => {
    mockReducedMotion(false);
    const cleanup = vi.fn();
    function WithCleanup() {
      const scope = useRef<HTMLDivElement>(null);
      useMotion(() => cleanup, { scope });
      return <div ref={scope} />;
    }
    const { unmount } = render(<WithCleanup />);
    expect(cleanup).not.toHaveBeenCalled();

    unmount();

    expect(cleanup).toHaveBeenCalledTimes(1);
  });

  it("runs the returned cleanup before rebuilding when the preference flips", () => {
    vi.useFakeTimers({ toFake: ["Date"] });
    const media = mockReducedMotion(false);
    const events: string[] = [];
    function WithCleanup() {
      const scope = useRef<HTMLDivElement>(null);
      useMotion(
        ({ reduced }) => {
          events.push(`build:${String(reduced)}`);
          return () => {
            events.push(`cleanup:${String(reduced)}`);
          };
        },
        { scope },
      );
      return <div ref={scope} />;
    }
    render(<WithCleanup />);

    flip(media, true);

    expect(events).toEqual(["build:false", "cleanup:false", "build:true"]);
  });

  it("removes its media-query listeners on unmount", () => {
    const media = mockReducedMotion(false);
    const { unmount } = render(<Probe onBuild={vi.fn()} />);
    expect(media.listenerCount()).toBeGreaterThan(0);

    unmount();

    expect(media.listenerCount()).toBe(0);
  });
});
</file>

<file path="src/lib/motion/use-motion.ts">
import type { DependencyList, RefObject } from "react";

import { gsap, useGSAP } from "@/lib/motion/gsap";

export type MotionContext = {
  /** The visitor asked for reduced motion. Apply the final state or a short fade; no scroll-linked scenes. */
  reduced: boolean;
  /**
   * Wrap an event handler (or any callback that runs later) that creates GSAP
   * animations. Tweens made outside `build`'s own call stack are not part of
   * the context and would survive the revert; wrapped ones are reverted with it.
   */
  contextSafe: <F extends (...args: never[]) => unknown>(handler: F) => F;
};

/**
 * The way to write a GSAP animation here (CLAUDE.md §8).
 *
 * - Everything created inside `build` (tweens, timelines, ScrollTriggers) is
 *   reverted when the component unmounts, when `dependencies` change, and when
 *   the reduced-motion preference flips: no ScrollTrigger outlives its page.
 * - `build` runs again with the new `reduced` value when the OS setting changes.
 * - Selector strings are scoped to `scope`.
 * - Animations created later, in event handlers, must go through
 *   `contextSafe(handler)` or they escape the revert.
 * - `build` may return a cleanup function. Use it for what GSAP cannot revert
 *   by itself, mainly event listeners and observers; it runs on the same three
 *   occasions as the revert.
 *
 * Contract for `build` when `reduced` is true: leave server-rendered content in
 * its final state, or use a fade of at most `reducedFade` seconds; no pinning,
 * scrubbing or looping.
 */
export function useMotion(
  // `void` in the union on purpose: most builds return nothing, and an
  // `undefined`-only type would force every one of them to say `return undefined`.
  // eslint-disable-next-line @typescript-eslint/no-invalid-void-type
  build: (context: MotionContext) => void | (() => void),
  options: { scope: RefObject<Element | null>; dependencies?: DependencyList },
): void {
  useGSAP(
    () => {
      const mm = gsap.matchMedia(options.scope.current ?? undefined);
      mm.add(
        {
          reduced: "(prefers-reduced-motion: reduce)",
          full: "(prefers-reduced-motion: no-preference)",
        },
        (context, contextSafe) =>
          build({
            reduced: context.conditions?.reduced === true,
            contextSafe: <F extends (...args: never[]) => unknown>(
              handler: F,
            ) => (contextSafe ? contextSafe(handler) : handler) as F,
          }),
      );
      return () => {
        mm.revert();
      };
    },
    {
      scope: options.scope,
      // useGSAP wants a mutable array; omitted = run once on mount.
      dependencies: options.dependencies ? [...options.dependencies] : [],
    },
  );
}
</file>

