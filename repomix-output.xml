<file path="src/components/shell/theme-sync.test.tsx">
import { cleanup, render } from "@testing-library/react";
import { afterEach, beforeEach, describe, expect, it } from "vitest";

import { ThemeSync } from "@/components/shell/theme-sync";
import { THEME_STORAGE_KEY } from "@/lib/theme";

const root = () => document.documentElement;

beforeEach(() => {
  window.localStorage.clear();
  root().className = "";
});

afterEach(() => {
  cleanup();
});

describe("ThemeSync", () => {
  it("renders nothing", () => {
    const { container } = render(<ThemeSync />);

    expect(container).toBeEmptyDOMElement();
  });

  it.each(["dark", "light"])(
    "puts the stored %s theme back on <html> (what a remounted root layout loses)",
    (choice) => {
      window.localStorage.setItem(THEME_STORAGE_KEY, choice);
      root().className = "font-variable antialiased"; // a fresh <html>: no theme class

      render(<ThemeSync />);

      expect(root().classList.contains(choice)).toBe(true);
      expect(root().classList.contains("antialiased")).toBe(true); // other classes are untouched
    },
  );

  it("adds nothing when no choice is stored: the system preference decides", () => {
    render(<ThemeSync />);

    expect(root().classList.contains("dark")).toBe(false);
    expect(root().classList.contains("light")).toBe(false);
  });

  it("leaves a class it did not set alone when nothing is stored (hydration must not clobber devtools, extensions or tests)", () => {
    root().classList.add("dark");

    render(<ThemeSync />);

    expect(root().classList.contains("dark")).toBe(true);
  });

  it("replaces a different theme class with the stored one (never both)", () => {
    window.localStorage.setItem(THEME_STORAGE_KEY, "light");
    root().classList.add("dark");

    render(<ThemeSync />);

    expect(root().classList.contains("light")).toBe(true);
    expect(root().classList.contains("dark")).toBe(false);
  });
});
</file>

<file path="src/components/ui/button.test.tsx">
import { render, screen } from "@testing-library/react";
import { describe, expect, it } from "vitest";

import { Button, buttonVariants } from "@/components/ui/button";

describe("Button", () => {
  it("is a type=button by default so it never submits a form by accident", () => {
    render(<Button>Save</Button>);

    expect(screen.getByRole("button", { name: "Save" })).toHaveAttribute(
      "type",
      "button",
    );
  });

  it("lets the caller choose type=submit", () => {
    render(<Button type="submit">Send</Button>);

    expect(screen.getByRole("button", { name: "Send" })).toHaveAttribute(
      "type",
      "submit",
    );
  });

  it("renders the child element with button styles when asChild is set", () => {
    render(
      <Button asChild variant="secondary">
        <a href="https://example.com/contact">Contact</a>
      </Button>,
    );

    const link = screen.getByRole("link", { name: "Contact" });
    expect(link).toHaveAttribute("href", "https://example.com/contact");
    expect(link).not.toHaveAttribute("type");
    expect(link).toHaveClass("border-border-strong");
  });

  it("uses semantic tokens for each variant", () => {
    expect(buttonVariants({ variant: "primary" })).toContain("bg-accent");
    expect(buttonVariants({ variant: "primary" })).toContain("text-on-accent");
    expect(buttonVariants({ variant: "secondary" })).toContain(
      "border-border-strong",
    );
    expect(buttonVariants({ variant: "tertiary" })).toContain("text-accent");
  });

  it("never offers a size below the 44px hit target", () => {
    expect(buttonVariants({ size: "md" })).toContain("min-h-11");
    expect(buttonVariants({ size: "lg" })).toContain("min-h-12");
    expect(buttonVariants({ size: "icon" })).toContain("size-11");
  });

  it("is disabled when asked", () => {
    render(<Button disabled>Nope</Button>);

    expect(screen.getByRole("button", { name: "Nope" })).toBeDisabled();
  });
});
</file>

