<file path="src/components/ui/use-toast.test.ts">
import { act, renderHook } from "@testing-library/react";
import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";

/** A fresh module per test: the store is module-level state. */
async function freshStore() {
  vi.resetModules();
  return import("@/components/ui/use-toast");
}

describe("toast store", () => {
  beforeEach(() => {
    vi.useFakeTimers();
  });
  afterEach(() => {
    vi.useRealTimers();
  });

  it("adds toasts newest first with deterministic ids and a default variant", async () => {
    const { toast, useToasts } = await freshStore();
    const { result } = renderHook(() => useToasts());

    act(() => {
      toast({ title: "first" });
      toast({ title: "second", variant: "success" });
    });

    expect(result.current.map((t) => t.title)).toEqual(["second", "first"]);
    expect(result.current.map((t) => t.id)).toEqual(["2", "1"]);
    expect(result.current.map((t) => t.variant)).toEqual([
      "success",
      "default",
    ]);
    expect(result.current.every((t) => t.open)).toBe(true);
  });

  it("keeps at most three toasts and drops the oldest", async () => {
    const { toast, useToasts } = await freshStore();
    const { result } = renderHook(() => useToasts());

    act(() => {
      for (const title of ["a", "b", "c", "d"]) toast({ title });
    });

    expect(result.current.map((t) => t.title)).toEqual(["d", "c", "b"]);
  });

  it("closes a toast first, then removes it after the exit animation", async () => {
    const { toast, useToasts } = await freshStore();
    const { result } = renderHook(() => useToasts());
    let handle: ReturnType<typeof toast> | undefined;

    act(() => {
      handle = toast({ title: "bye" });
    });
    act(() => {
      handle?.dismiss();
    });

    expect(result.current).toHaveLength(1);
    expect(result.current[0]?.open).toBe(false);

    act(() => {
      vi.advanceTimersByTime(600);
    });

    expect(result.current).toHaveLength(0);
  });

  it("dismissing twice schedules a single removal and never throws", async () => {
    const { toast, dismissToast, useToasts } = await freshStore();
    const { result } = renderHook(() => useToasts());
    let id = "";

    act(() => {
      id = toast({ title: "x" }).id;
    });
    act(() => {
      dismissToast(id);
      dismissToast(id);
      dismissToast("does-not-exist");
    });
    act(() => {
      vi.advanceTimersByTime(600);
    });

    expect(result.current).toHaveLength(0);
  });
});
</file>

<file path="src/components/ui/use-toast.ts">
"use client";

import { useSyncExternalStore } from "react";

/**
 * Tiny external store behind <Toaster />. Client-only on purpose: calling
 * toast() on the server would share state between requests.
 */

export type ToastVariant = "default" | "success" | "danger";

export type ToastAction = {
  label: string;
  /** Radix requires an alternative description for the action (screen readers and F8 hotkey users). */
  altText: string;
  onClick: () => void;
};

export type ToastOptions = {
  title?: string;
  description?: string;
  variant?: ToastVariant;
  action?: ToastAction;
};

export type ToastItem = ToastOptions & {
  id: string;
  variant: ToastVariant;
  open: boolean;
};

/** Newest toasts win; older ones are dropped beyond this many. */
const LIMIT = 3;
/** Keep a closed toast mounted long enough for its exit animation. */
const REMOVE_DELAY_MS = 600;

const EMPTY: readonly ToastItem[] = [];
let items: readonly ToastItem[] = EMPTY;
let counter = 0;
const listeners = new Set<() => void>();
const removalTimers = new Map<string, ReturnType<typeof setTimeout>>();

function setItems(next: readonly ToastItem[]) {
  items = next;
  for (const listener of listeners) listener();
}

export function dismissToast(id: string) {
  setItems(items.map((t) => (t.id === id ? { ...t, open: false } : t)));
  if (removalTimers.has(id)) return;
  removalTimers.set(
    id,
    setTimeout(() => {
      removalTimers.delete(id);
      setItems(items.filter((t) => t.id !== id));
    }, REMOVE_DELAY_MS),
  );
}

export function toast(options: ToastOptions): {
  id: string;
  dismiss: () => void;
} {
  counter += 1;
  const id = String(counter);
  setItems(
    [
      { ...options, variant: options.variant ?? "default", id, open: true },
      ...items,
    ].slice(0, LIMIT),
  );
  return {
    id,
    dismiss: () => {
      dismissToast(id);
    },
  };
}

function subscribe(listener: () => void) {
  listeners.add(listener);
  return () => {
    listeners.delete(listener);
  };
}

export function useToasts(): readonly ToastItem[] {
  return useSyncExternalStore(
    subscribe,
    () => items,
    () => EMPTY,
  );
}
</file>

