<file path="src/components/contact/inquiry-form.tsx">
"use client";

import { useLocale, useTranslations } from "next-intl";
import {
  useActionState,
  useEffect,
  useId,
  useRef,
  useState,
  type SyntheticEvent,
} from "react";

import { submitInquiry } from "@/app/[locale]/contact/actions";
import {
  ChoiceGroup,
  TextAreaField,
  TextField,
} from "@/components/contact/form-fields";
import { TurnstileWidget } from "@/components/contact/turnstile-widget";
import { Button } from "@/components/ui/button";
import { Checkbox } from "@/components/ui/checkbox";
import { Label } from "@/components/ui/label";
import { Link } from "@/i18n/navigation";
import type { SubmitResult } from "@/lib/inquiry/result";
import {
  budgetValues,
  firstStepWithError,
  needValues,
  parseStep,
  stepFields,
  stepIds,
  timelineValues,
  type ErrorCode,
  type FieldErrors,
  type FieldName,
  type RawInquiry,
  type StepId,
} from "@/lib/inquiry/schema";
import { resolveInternalPath } from "@/lib/navigation";

type FormState = SubmitResult | { status: "idle" };

/**
 * The inquiry form: four steps (need, budget, timeline, your details) in one
 * <form> whose Server Action does the real validation. Each step is checked in
 * the browser first, with the same schema, so a mistake is caught where it was
 * made; the server checks everything again and can send the visitor back to
 * the step with the problem.
 *
 * Accessibility: every field has a visible label; a hint and an error are
 * linked with aria-describedby; a failed step shows an error summary that takes
 * focus; moving between steps moves focus to the step's heading; native radios
 * and a real checkbox, all reachable by keyboard.
 *
 * Values of earlier steps travel as hidden inputs, so the one FormData the
 * action receives holds the whole inquiry. The marketing consent is its own
 * unticked checkbox and never blocks sending.
 */
export function InquiryForm({
  turnstileSiteKey,
  initialNeed,
}: {
  turnstileSiteKey?: string;
  /** Pre-selected need, from `?service=` (a topic, never personal data). */
  initialNeed?: (typeof needValues)[number] | undefined;
}) {
  const t = useTranslations("contact.form");
  const locale = useLocale();
  const uid = useId();

  const [state, formAction, pending] = useActionState<FormState, FormData>(
    submitInquiry,
    { status: "idle" },
  );
  const [seen, setSeen] = useState<FormState>(state);
  const [step, setStep] = useState<StepId>("need");
  const [values, setValues] = useState<RawInquiry>({
    marketingConsent: false,
    ...(initialNeed !== undefined ? { need: initialNeed } : {}),
  });
  const [errors, setErrors] = useState<FieldErrors>({});
  const [attention, setAttention] = useState(0);
  const [token, setToken] = useState("");

  const heading = useRef<HTMLHeadingElement>(null);
  const alert = useRef<HTMLDivElement>(null);
  const movedBefore = useRef(false);

  // A result from the server arrived: show what it says (render-time update, the documented pattern).
  if (state !== seen) {
    setSeen(state);
    if (state.status === "error") {
      if (state.code === "validation") {
        setErrors(state.fieldErrors);
        const target = firstStepWithError(state.fieldErrors);
        if (target !== null) setStep(target);
      }
      setAttention((count) => count + 1);
    }
  }

  const index = stepIds.indexOf(step);
  const isLast = index === stepIds.length - 1;

  // After a step change, put the focus on the step's heading (not on first render).
  useEffect(() => {
    if (movedBefore.current) heading.current?.focus();
    movedBefore.current = true;
  }, [step]);

  // After a failed check, the summary or failure message takes focus.
  useEffect(() => {
    if (attention > 0) alert.current?.focus();
  }, [attention]);

  const fieldId = (name: FieldName) => `${uid}-${name}`;
  const set = (name: FieldName, value: string | boolean) => {
    setValues((current) => ({ ...current, [name]: value }));
  };

  const message = (name: FieldName): string | null => {
    const code: ErrorCode | undefined = errors[name];
    if (code === undefined) return null;
    if (name === "email" && code === "invalid") return t("errors.emailInvalid");
    if (code === "required" && ["need", "budget", "timeline"].includes(name))
      return t("errors.choose");
    return t(`errors.${code}`);
  };

  // The consent checkbox cannot be invalid, so it has no label for the summary.
  const fieldLabel = (name: FieldName): string =>
    name === "marketingConsent" ? "" : t(`fields.${name}`);

  const goNext = () => {
    const result = parseStep(step, values);
    if (!result.ok) {
      setErrors(result.errors);
      setAttention((count) => count + 1);
      return false;
    }
    setErrors({});
    const following = stepIds.at(index + 1);
    if (following !== undefined) setStep(following);
    return true;
  };

  const onSubmit = (event: SyntheticEvent<HTMLFormElement>) => {
    if (pending) {
      event.preventDefault();
      return;
    }
    if (!isLast) {
      event.preventDefault();
      goNext();
      return;
    }
    const result = parseStep("contact", values);
    if (!result.ok) {
      event.preventDefault();
      setErrors(result.errors);
      setAttention((count) => count + 1);
    }
  };

  const goBack = () => {
    setErrors({});
    const previous = index > 0 ? stepIds.at(index - 1) : undefined;
    if (previous !== undefined) setStep(previous);
  };

  const errorFields = (Object.keys(errors) as FieldName[]).filter(
    (name) => errors[name] !== undefined,
  );
  const failure =
    state.status === "error" && state.code !== "validation" ? state : null;

  const privacyTarget = resolveInternalPath("/privacy");

  return (
    <form
      action={formAction}
      onSubmit={onSubmit}
      noValidate
      aria-labelledby={`${uid}-title`}
      className="grid gap-8"
    >
      <h2 id={`${uid}-title`} className="text-3xl text-text">
        {t("title")}
      </h2>

      {/*
        The steps need JavaScript to move between them; without it the visitor
        is told, not left with a button that does nothing useful. Not a <noscript>
        element: React renders no children inside it, so the text would never
        reach the HTML. It is a normal paragraph that is hidden, and shown only
        where scripting is off (`@media (scripting: none)`), so nothing flashes
        or shifts for people who have JavaScript.
      */}
      <p
        data-no-js-notice=""
        className="hidden border border-border-strong p-4 text-base text-text [@media(scripting:none)]:block"
      >
        {t("noscript")}
      </p>

      {/* The page's language, for the reply and the confirmation page; the action checks it is one of ours. */}
      <input type="hidden" name="locale" value={locale} />

      <nav aria-label={t("progressLabel")}>
        <ol className="flex flex-wrap gap-x-6 gap-y-2">
          {stepIds.map((id, position) => (
            <li
              key={id}
              aria-current={id === step ? "step" : undefined}
              className={
                id === step
                  ? "border-b-2 border-accent pb-1 font-mono text-xs text-text uppercase"
                  : "pb-1 font-mono text-xs text-text-muted uppercase"
              }
            >
              {position + 1}. {t(`steps.${id}`)}
            </li>
          ))}
        </ol>
      </nav>

      {errorFields.length > 0 ? (
        <div
          ref={alert}
          role="alert"
          tabIndex={-1}
          className="grid gap-2 border border-danger p-4"
        >
          <p className="font-medium text-text">{t("errors.summaryTitle")}</p>
          <ul className="grid list-disc gap-1 ps-5 text-base text-text-secondary">
            {errorFields.map((name) => (
              <li key={name}>
                {stepFields[step].some((field) => field === name) ? (
                  <a
                    href={`#${fieldId(name)}`}
                    className="text-accent underline underline-offset-4"
                  >
                    {fieldLabel(name)}
                  </a>
                ) : (
                  fieldLabel(name)
                )}
                : {message(name)}
              </li>
            ))}
          </ul>
        </div>
      ) : failure !== null ? (
        <div
          ref={alert}
          role="alert"
          tabIndex={-1}
          className="border border-danger p-4 text-base text-text"
        >
          {failure.code === "rate_limited"
            ? t("failure.rate_limited", {
                minutes: Math.max(1, Math.ceil(failure.retryAfterSec / 60)),
              })
            : t(`failure.${failure.code}`)}
        </div>
      ) : null}

      <div className="grid gap-6">
        <p className="text-sm text-text-muted">
          {t("progress", { current: index + 1, total: stepIds.length })}
        </p>
        <h3
          ref={heading}
          tabIndex={-1}
          className="text-2xl text-text outline-none"
        >
          {t(`steps.${step}`)}
        </h3>

        {step === "need" ? (
          <>
            <ChoiceGroup
              id={fieldId("need")}
              name="need"
              legend={t("need.legend")}
              options={needValues.map((value) => ({
                value,
                label: t(`need.options.${value}`),
              }))}
              value={values.need as string | undefined}
              onChange={(value) => {
                set("need", value);
              }}
              error={message("need")}
            />
            <TextAreaField
              id={fieldId("description")}
              name="description"
              label={t("need.descriptionLabel")}
              hint={t("need.descriptionHint")}
              rows={6}
              value={(values.description as string | undefined) ?? ""}
              onChange={(event) => {
                set("description", event.target.value);
              }}
              error={message("description")}
            />
          </>
        ) : null}

        {step === "budget" ? (
          <ChoiceGroup
            id={fieldId("budget")}
            name="budget"
            legend={t("budget.legend")}
            hint={t("budget.hint")}
            options={budgetValues.map((value) => ({
              value,
              label: t(`budget.options.${value}`),
            }))}
            value={values.budget as string | undefined}
            onChange={(value) => {
              set("budget", value);
            }}
            error={message("budget")}
          />
        ) : null}

        {step === "timeline" ? (
          <ChoiceGroup
            id={fieldId("timeline")}
            name="timeline"
            legend={t("timeline.legend")}
            hint={t("timeline.hint")}
            options={timelineValues.map((value) => ({
              value,
              label: t(`timeline.options.${value}`),
            }))}
            value={values.timeline as string | undefined}
            onChange={(value) => {
              set("timeline", value);
            }}
            error={message("timeline")}
          />
        ) : null}

        {step === "contact" ? (
          <>
            <p className="text-lg text-text-secondary">{t("contact.intro")}</p>
            <TextField
              id={fieldId("name")}
              name="name"
              label={t("contact.nameLabel")}
              autoComplete="name"
              value={(values.name as string | undefined) ?? ""}
              onChange={(event) => {
                set("name", event.target.value);
              }}
              error={message("name")}
            />
            <TextField
              id={fieldId("email")}
              name="email"
              type="email"
              label={t("contact.emailLabel")}
              hint={t("contact.emailHint")}
              autoComplete="email"
              inputMode="email"
              value={(values.email as string | undefined) ?? ""}
              onChange={(event) => {
                set("email", event.target.value);
              }}
              error={message("email")}
            />
            <TextField
              id={fieldId("company")}
              name="company"
              label={t("contact.companyLabel")}
              autoComplete="organization"
              value={(values.company as string | undefined) ?? ""}
              onChange={(event) => {
                set("company", event.target.value);
              }}
              error={message("company")}
            />

            <div className="flex items-start gap-3">
              <Checkbox
                id={fieldId("marketingConsent")}
                checked={values.marketingConsent === true}
                onCheckedChange={(checked) => {
                  set("marketingConsent", checked === true);
                }}
                aria-describedby={`${fieldId("marketingConsent")}-hint`}
              />
              <div className="grid gap-1">
                <Label htmlFor={fieldId("marketingConsent")}>
                  {t("consent.marketing")}
                </Label>
                <p
                  id={`${fieldId("marketingConsent")}-hint`}
                  className="text-sm text-text-muted"
                >
                  {t("consent.marketingHint")}
                </p>
              </div>
            </div>
            {values.marketingConsent === true ? (
              <input type="hidden" name="marketingConsent" value="on" />
            ) : null}

            {turnstileSiteKey !== undefined ? (
              <div className="grid gap-2">
                <p className="text-sm text-text-muted">{t("turnstile")}</p>
                <TurnstileWidget
                  key={attention}
                  siteKey={turnstileSiteKey}
                  onToken={setToken}
                />
                <input type="hidden" name="turnstileToken" value={token} />
              </div>
            ) : null}

            <p className="text-sm text-text-muted">
              {t.rich("privacy", {
                link: (chunks) =>
                  privacyTarget.kind === "page" ? (
                    <Link
                      href={privacyTarget.href}
                      className="text-accent underline underline-offset-4"
                    >
                      {chunks}
                    </Link>
                  ) : (
                    chunks
                  ),
              })}
            </p>
          </>
        ) : null}
      </div>

      {/* Earlier steps' answers travel with the last submit. */}
      {stepIds
        .filter((id) => id !== step)
        .flatMap((id) => stepFields[id])
        .filter((name) => name !== "marketingConsent")
        .map((name) =>
          typeof values[name] === "string" ? (
            <input key={name} type="hidden" name={name} value={values[name]} />
          ) : null,
        )}

      {/* Honeypot: invisible and unfocusable for people; bots that fill every field give themselves away. */}
      <div aria-hidden="true" className="sr-only">
        <label>
          Website
          <input
            type="text"
            name="website"
            tabIndex={-1}
            autoComplete="off"
            defaultValue=""
          />
        </label>
      </div>

      <div className="flex flex-wrap items-center gap-4">
        {index > 0 ? (
          <Button
            type="button"
            variant="secondary"
            size="lg"
            onClick={goBack}
            disabled={pending}
          >
            {t("buttons.back")}
          </Button>
        ) : null}
        <Button type="submit" size="lg" disabled={pending} aria-busy={pending}>
          {isLast
            ? pending
              ? t("buttons.sending")
              : t("buttons.submit")
            : t("buttons.next")}
        </Button>
      </div>
    </form>
  );
}
</file>

<file path="src/components/fx/fx-structure.test.ts">
// @vitest-environment node
import { readdirSync, readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { describe, expect, it } from "vitest";

/**
 * Executable form of "FX code must not bloat pages that do not use it"
 * (ROADMAP P1.6): the part of an FX component that a page imports must stay
 * small, and everything heavy sits behind `next/dynamic`.
 */

const dir = fileURLToPath(new URL(".", import.meta.url));
const files = readdirSync(dir).filter(
  (name) => /\.tsx?$/.test(name) && !/\.test\.tsx?$/.test(name),
);
const read = (name: string) => readFileSync(`${dir}${name}`, "utf8");

const isMotion = (name: string) => name.endsWith(".motion.tsx");
const wrappers = files.filter((name) => !isMotion(name));
const motions = files.filter(isMotion);

/** Import specifiers of static `import ... from "x"` statements (dynamic `import()` is not listed). */
function staticImports(source: string): string[] {
  return [
    ...source.matchAll(/^\s*import\s[^;]*?from\s+["']([^"']+)["']/gm),
  ].map((match) => match[1]);
}

const HEAVY = [
  "gsap",
  "@gsap/react",
  "lenis",
  "@/lib/motion/gsap",
  "@/lib/motion/use-motion",
];

describe("FX code splitting", () => {
  it("finds the components it is meant to guard", () => {
    expect(motions.sort()).toEqual([
      "magnetic-button.motion.tsx",
      "scroll-pinned-section.motion.tsx",
      "spotlight-card.motion.tsx",
      "text-reveal.motion.tsx",
    ]);
    expect(wrappers).toEqual(
      expect.arrayContaining([
        "gradient-mesh.tsx",
        "magnetic-button.tsx",
        "marquee.tsx",
        "scroll-pinned-section.tsx",
        "spotlight-card.tsx",
        "text-reveal.tsx",
      ]),
    );
  });

  it.each(wrappers)(
    "%s never statically imports GSAP, Lenis or useMotion",
    (name) => {
      const imports = staticImports(read(name));
      for (const heavy of HEAVY) expect(imports).not.toContain(heavy);
      for (const specifier of imports) {
        expect(specifier, `${name} imports a motion module`).not.toMatch(
          /\.motion$/,
        );
      }
    },
  );

  it.each(motions)(
    "%s is a default export (what next/dynamic loads) and uses useMotion",
    (name) => {
      const source = read(name);
      expect(source).toMatch(/export default function/);
      expect(source).toContain("useMotion(");
      expect(source.startsWith('"use client"')).toBe(true);
    },
  );

  it.each(motions)(
    "%s is reached only through next/dynamic with ssr:false",
    (name) => {
      const stem = name.replace(".motion.tsx", "");
      const owner = read(`${stem}.tsx`);
      expect(owner).toMatch(
        new RegExp(
          `dynamic\\(\\s*\\(\\) => import\\("@/components/fx/${stem}\\.motion"\\)`,
        ),
      );
      expect(owner).toMatch(/ssr: false/);
    },
  );

  it("the motion chunks are mounted only behind useFxReady", () => {
    for (const name of wrappers.filter((file) =>
      read(file).includes("Motion"),
    )) {
      if (name === "use-fx-ready.ts") continue;
      // `ready ? <XMotion` or, where a component can also run without JS, `ready && cond ? <XMotion`
      expect(read(name), name).toMatch(/ready (?:&& [^?]+ )?\? <\w+Motion/);
    }
  });

  it("the CSS-only components are server components with no client JavaScript", () => {
    for (const name of ["marquee.tsx", "gradient-mesh.tsx"]) {
      const source = read(name);
      expect(source, name).not.toMatch(/["']use client["']/);
      expect(source, name).not.toMatch(
        /\buse(State|Effect|Ref|Layout|Motion|Gsap)/,
      );
    }
  });

  it("nothing in the FX folder animates a layout property", () => {
    const layout = /\b(width|height|top|left|right|bottom|margin|padding)\s*:/;
    for (const name of motions) {
      // only the vars passed to gsap are interesting; the motion files hold nothing else
      const source = read(name)
        .replace(/\/\*[\s\S]*?\*\//g, "")
        .replace(/\/\/.*$/gm, "");
      expect(source, name).not.toMatch(layout);
    }
  });
});
</file>

<file path="src/components/fx/scroll-pinned-section.tsx">
"use client";

import dynamic from "next/dynamic";
import { useRef, type ReactNode } from "react";

import { useFxReady } from "@/components/fx/use-fx-ready";
import { cn } from "@/lib/utils";

const PinnedMotion = dynamic(
  () => import("@/components/fx/scroll-pinned-section.motion"),
  { ssr: false },
);

/**
 * The pinned-story pattern (docs/DESIGN.md §6.3): the section sticks to the
 * viewport while scrolling reveals its steps one after another and fills a
 * progress bar. Use at most one per viewport.
 *
 * Every step is server-rendered, visible and in reading order. Without
 * JavaScript, under reduced motion, or when the section is taller than the
 * viewport (small or landscape screens, where pinning would cut content off),
 * it is a plain section of stacked steps: no pin, no scrub, no hidden text.
 *
 * Steps are text: a step that fades in while still invisible would be
 * focusable, so do not put links or controls inside them.
 */
export function ScrollPinnedSection({
  children,
  steps,
  "aria-labelledby": labelledBy,
  className,
}: {
  /** The section heading and intro, always visible. */
  children: ReactNode;
  steps: readonly ReactNode[];
  /** Id of the heading that names the section (it becomes a labelled region). */
  "aria-labelledby"?: string;
  className?: string;
}) {
  const ref = useRef<HTMLElement>(null);
  const ready = useFxReady();

  return (
    <>
      {/*
        The wrapper is never pinned. ScrollTrigger moves the pinned section into
        a spacer element; if the section were the outermost node React removes
        (a conditional render, a changed key), `removeChild` would fail because
        the section is no longer a child of its original parent.
      */}
      <div data-fx="pinned-section">
        <section
          ref={ref}
          aria-labelledby={labelledBy}
          className={cn(
            "flex min-h-dvh flex-col justify-center gap-8",
            className,
          )}
        >
          {children}
          {/* Hidden until the motion pins the section: a full bar means nothing when static. */}
          <div
            aria-hidden="true"
            data-fx-progress-track
            className="invisible h-1 bg-surface-3"
          >
            <div data-fx-progress className="h-full origin-left bg-accent" />
          </div>
          <ol className="grid gap-6">
            {steps.map((step, index) => (
              <li
                // Positional and fixed: steps are never reordered.
                key={index}
                data-fx-step
                className="grid gap-1 border-t border-border-subtle pt-4"
              >
                <span
                  aria-hidden="true"
                  className="font-mono text-xs text-text-muted uppercase"
                >
                  {String(index + 1).padStart(2, "0")}
                </span>
                {step}
              </li>
            ))}
          </ol>
        </section>
      </div>
      {ready ? <PinnedMotion scope={ref} /> : null}
    </>
  );
}
</file>

<file path="src/components/fx/text-reveal.tsx">
"use client";

import dynamic from "next/dynamic";
import { Fragment, useRef } from "react";

import { useFxReady } from "@/components/fx/use-fx-ready";

// GSAP stays out of the page's own bundle: this chunk loads after idle, and
// never under reduced motion.
const TextRevealMotion = dynamic(
  () => import("@/components/fx/text-reveal.motion"),
  { ssr: false },
);

type HeadingTag = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";

/** docs/DESIGN.md §6.3: 40 ms per word, never more than 600 ms in total. */
const WORD_STAGGER_MS = 40;
const MAX_TOTAL_STAGGER_MS = 600;

/**
 * Kinetic headline: the words rise and fade in.
 *
 * - `when="view"` (default): once, when the heading scrolls into view. GSAP,
 *   loaded after idle. A heading that is already on screen is left alone
 *   (hiding visible text to animate it in would be a flash).
 * - `when="load"`: as the page paints, for a hero headline. **CSS only**: a
 *   keyframe from the `--animate-word-rise` token with a per-word delay, so it
 *   needs no JavaScript, hides nothing that JavaScript must reveal, and plays
 *   from the very first paint (the words are present in the server HTML; the
 *   animation just starts them from an offset). The first word shows at once,
 *   the last after at most 600 ms.
 *
 * Either way the text is server-rendered complete and in place. Without
 * JavaScript it is readable (and in `load` mode still animates); under reduced
 * motion the token is `none` and nothing moves. Assistive technology reads the
 * whole heading from `aria-label`; the split words are `aria-hidden`.
 */
export function TextReveal({
  text,
  as: Tag = "h2",
  when = "view",
  className,
}: {
  text: string;
  as?: HeadingTag;
  when?: "view" | "load";
  className?: string;
}) {
  const ref = useRef<HTMLHeadingElement>(null);
  const ready = useFxReady();
  const words = text.split(/\s+/).filter(Boolean);
  const onLoad = when === "load";
  const stagger = Math.min(
    WORD_STAGGER_MS,
    MAX_TOTAL_STAGGER_MS / Math.max(words.length - 1, 1),
  );

  return (
    <>
      <Tag
        ref={ref}
        aria-label={text}
        data-fx="text-reveal"
        className={className}
      >
        <span aria-hidden="true">
          {words.map((word, index) => (
            <Fragment key={`${word}-${String(index)}`}>
              {index > 0 ? " " : null}
              <span
                data-fx-word
                className={
                  onLoad ? "inline-block animate-word-rise" : "inline-block"
                }
                style={
                  onLoad
                    ? {
                        animationDelay: `${String(Math.round(index * stagger))}ms`,
                      }
                    : undefined
                }
              >
                {word}
              </span>
            </Fragment>
          ))}
        </span>
      </Tag>
      {ready && !onLoad ? <TextRevealMotion scope={ref} /> : null}
    </>
  );
}
</file>

