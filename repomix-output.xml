"use client";

import type { RefObject } from "react";

import { gsap } from "@/lib/motion/gsap";
import { duration, ease, revealOffset } from "@/lib/motion/tokens";
import { useMotion } from "@/lib/motion/use-motion";

/** Same threshold as the scroll trigger below: "top 85%" of the viewport. */
const TRIGGER_AT = 0.85;
/** docs/DESIGN.md §6.3: stagger of 40 ms per item, never more than 600 ms in total. */
const WORD_STAGGER = 0.04;
const MAX_TOTAL_STAGGER = 0.6;

export default function TextRevealMotion({
  scope,
}: {
  scope: RefObject<HTMLElement | null>;
}) {
  useMotion(
    ({ reduced }) => {
      const heading = scope.current;
      if (reduced || !heading) return;
      // Already past the trigger line (on screen, or scrolled past): leave it
      // as rendered. Hiding visible text to animate it in would be a flash.
      if (heading.getBoundingClientRect().top < window.innerHeight * TRIGGER_AT)
        return;

      const words = gsap.utils.toArray<HTMLElement>("[data-fx-word]", heading);
      gsap.from(words, {
        opacity: 0,
        y: revealOffset,
        duration: duration.reveal,
        ease: ease.out,
        stagger: Math.min(
          WORD_STAGGER,
          MAX_TOTAL_STAGGER / Math.max(words.length - 1, 1),
        ),
        scrollTrigger: { trigger: heading, start: "top 85%", once: true },
      });
    },
    { scope },
  );
  return null;
}
</file>

<file path="src/components/fx/use-fx-ready.ts">
import { useAfterIdle } from "@/lib/motion/use-after-idle";
import { useMediaQuery } from "@/lib/motion/use-media-query";
import { useReducedMotion } from "@/lib/motion/use-reduced-motion";

/**
 * Whether an FX component should load its motion chunk now.
 *
 * False on the server, during hydration and until the browser is idle (the
 * static markup is all that exists then), and false for good under reduced
 * motion, so those visitors never download the code. `pointer: true` also
 * requires a mouse-like device (hover + fine pointer) for effects that follow
 * the cursor.
 *
 * It follows the preference live: flipping reduced motion on unmounts the motion
 * chunk (its `useMotion` reverts everything), flipping it off mounts it again.
 */
export function useFxReady(options: { pointer?: boolean } = {}): boolean {
  const reduced = useReducedMotion();
  const idle = useAfterIdle();
  const finePointer = useMediaQuery("(hover: hover) and (pointer: fine)");
  return idle && !reduced && (options.pointer !== true || finePointer);
}
</file>

