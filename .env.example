# Environment variable contract. Copy to `.env.local` (never committed) and fill in.
# Rules (CLAUDE.md §6, §10):
#   - This file holds placeholders only. Never put a real secret in it.
#   - Read env only through `src/lib/env.ts` (Zod-validated; added in P1.7).
#   - Only NEXT_PUBLIC_* values may reach the browser, and they must never be secrets.
#   - Dev, Preview and Production use separate values; Preview never uses production secrets.
#     Per-environment values and Vercel commands: docs/DEPLOYMENT.md §3.
# Not listed here on purpose: API_KEY_21ST (21st MCP) lives in your shell profile or OS keychain.

# ---------------------------------------------------------------------------
# Public (exposed to the browser: non-secret only)
# ---------------------------------------------------------------------------

# Canonical origin, used for metadata, sitemap and canonical URLs (P2.6).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key. The value below is Cloudflare's published
# always-passes test key for development; use a real key per environment.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ---------------------------------------------------------------------------
# Server only (secrets; files that read these start with `import 'server-only'`)
# ---------------------------------------------------------------------------

# Postgres, EU region (decision D5). Separate database branch per environment.
DATABASE_URL=postgresql://user:password@localhost:5432/website_dev

# Upstash Redis, EU region: rate limiting (P2.5).
UPSTASH_REDIS_REST_URL=https://example-eu.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# Cloudflare Turnstile secret key. The value below is Cloudflare's published
# always-passes test secret for development; use a real key per environment.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Salt for hashing client IPs before rate limiting. Rotate regularly; the raw IP is never stored.
RATE_LIMIT_IP_SALT=replace-me-with-a-long-random-string

# Transactional email, EU provider (decision D5; provider chosen in P2.5).
EMAIL_API_KEY=replace-me
EMAIL_FROM=no-reply@example.com
INQUIRY_NOTIFY_TO=inbox@example.com

# Claude API for live demos (P3.0+). Leave empty to run demos in simulation only.
ANTHROPIC_API_KEY=

# Kill switch: demos run in simulation unless this is exactly "true" (P3.0).
DEMOS_LIVE_ENABLED=false
