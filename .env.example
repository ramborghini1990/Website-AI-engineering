# Environment variable contract. Copy to `.env.local` (never committed) and fill in.
# Rules (CLAUDE.md §6, §10):
#   - This file holds placeholders only. Never put a real secret in it.
#   - Read env only through `src/lib/env.ts` (server) or `src/lib/env.client.ts` (browser,
#     NEXT_PUBLIC_* only). Both are Zod-validated by `src/lib/env-schema.ts`; an invalid value
#     fails `next build`, and so does a client component importing the server module.
#   - Blank means unset (`KEY=`). Variables that belong together must be set together
#     (Turnstile pair, Upstash pair, the three email variables).
#   - Only NEXT_PUBLIC_* values may reach the browser, and they must never be secrets.
#   - Dev, Preview and Production use separate values; Preview never uses production secrets.
#     Per-environment values and Vercel commands: docs/DEPLOYMENT.md §3.
# Not listed here on purpose: API_KEY_21ST (21st MCP) lives in your shell profile or OS keychain.

# ---------------------------------------------------------------------------
# Public (exposed to the browser: non-secret only)
# ---------------------------------------------------------------------------

# Canonical origin, used for canonical and hreflang URLs (P1.4), sitemap and OG (P2.6).
# If empty, src/lib/env.ts falls back to Vercel's URLs, then to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin of the cookieless analytics script and event endpoint (decision D6, wired in P2.6).
# Only an origin: https://host, no path or trailing slash. Empty = no analytics origin in the CSP.
NEXT_PUBLIC_PLAUSIBLE_ORIGIN=

# Public booking page on the EU instance of Cal.com (P2.7), e.g. https://cal.eu/your-handle/intro
# Only cal.eu or app.cal.eu is accepted (an EU processor). Empty = no booking section on /contact
# and no extra origin in the CSP. The page is loaded only after the visitor clicks (ConsentGate).
NEXT_PUBLIC_CAL_URL=

# Cloudflare Turnstile site key. The value below is Cloudflare's published
# always-passes test key for development; use a real key per environment.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ---------------------------------------------------------------------------
# Server only (secrets; files that read these start with `import 'server-only'`)
# ---------------------------------------------------------------------------

# Content Security Policy (src/proxy.ts, docs/SECURITY.md).
#   report-only (default): browsers report violations, nothing is blocked
#   enforce:               violations are blocked
#   off:                   no CSP header
CSP_MODE=report-only
# Optional collector for violation reports. If it is not ours it is a processor: list it in the privacy notice.
CSP_REPORT_URI=

# CI only, set in the workflow and never here: SKIP_ENV_VALIDATION=1 lets `next build` run without
# secrets. It is ignored at runtime, so it cannot put an unvalidated app in front of visitors.

# Postgres, EU region (decision D5). Separate database branch per environment.
DATABASE_URL=postgresql://user:password@localhost:5432/website_dev

# Upstash Redis, EU region: rate limiting of the inquiry form (P2.5). Unset locally: an in-process limiter is used.
# On Vercel (VERCEL_ENV set) the contact form needs DATABASE_URL, Upstash, Turnstile, the salt and email, all of them,
# or it shows itself as unavailable (docs/DEPLOYMENT.md, the inquiry funnel section).
UPSTASH_REDIS_REST_URL=https://example-eu.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# Cloudflare Turnstile secret key. The value below is Cloudflare's published
# always-passes test secret for development; use a real key per environment.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Salt for hashing client IPs before rate limiting. Rotate regularly; the raw IP is never stored.
RATE_LIMIT_IP_SALT=replace-me-with-a-long-random-string

# Transactional email through Resend's REST API (decision D5, chosen in P2.5; no SDK).
# EMAIL_FROM must be on a domain verified with the provider. INQUIRY_NOTIFY_TO receives each inquiry.
EMAIL_API_KEY=replace-me
EMAIL_FROM=no-reply@example.com
INQUIRY_NOTIFY_TO=inbox@example.com

# Claude API for live demos (P3.0+). Leave empty to run demos in simulation only.
ANTHROPIC_API_KEY=

# Kill switch: demos run in simulation unless this is exactly "true" (P3.0).
DEMOS_LIVE_ENABLED=false
